<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- MainActivity accepts cleartext only for loopback, .local and RFC1918/private hosts. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
